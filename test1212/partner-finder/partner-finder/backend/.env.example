# Copy this file to .env  (cp .env.example .env)  and adjust if needed.

# PostgreSQL connection. Matches the docker command in the README.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/partnerfinder

# Secret used to sign login tokens (JWT). REQUIRED: replace with a long random string.
# e.g. generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Address of the frontend (allowed to call the API and open the chat socket).
CLIENT_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=4000

# Optional: comma-separated e-mails that get the Admin page. Leave empty to turn the admin area off.
ADMIN_EMAILS=
